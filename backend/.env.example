# Copy to ".env" and fill in. Never commit .env.

PORT=3000
NODE_ENV=production

# Enquiries delivery mode:
# "file" = enquiries and chatbot leads are saved directly to backend/data/enquiries.jsonl (no email account needed).
# "smtp" = sends real email via an SMTP server.
# "log"  = dev mode: logs message to console without sending or saving.
MAIL_MODE=file
MAIL_TO=info@kalpanaaasoftwaresolutions.in

# Server settings
SERVE_STATIC=true
TRUST_PROXY=
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=15

# AI chatbot (POST /api/chat), powered by the NVIDIA API (build.nvidia.com).
# Generate an API key at https://build.nvidia.com/settings/api-keys (starts with nvapi-).
CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_API_KEY=

# OPTIONAL: Only needed if you switch to MAIL_MODE=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=info@kalpanaaasoftwaresolutions.in
# SMTP_PASS=
# MAIL_FROM=info@kalpanaaasoftwaresolutions.in
