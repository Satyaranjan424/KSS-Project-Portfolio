# Copy to ".env" and fill in. Never commit .env.

PORT=3000
NODE_ENV=production

# Where enquiries are delivered
MAIL_TO=info@kalpanaaasoftwaresolutions.in

# "smtp" sends real email. "log" builds the message but sends nothing (local testing).
MAIL_MODE=smtp

# SMTP account for the company mailbox (see README for provider notes)
SMTP_HOST=
SMTP_PORT=587
# true => implicit TLS (use with port 465). false => STARTTLS (port 587). Defaults from the port.
# SMTP_SECURE=false
SMTP_USER=info@kalpanaaasoftwaresolutions.in
SMTP_PASS=
# From address; must be a mailbox your SMTP account is allowed to send as. Defaults to SMTP_USER.
# MAIL_FROM=info@kalpanaaasoftwaresolutions.in

# Behind nginx / a load balancer / PaaS: number of proxy hops, so rate limiting sees the real client IP.
# Leave empty when the Node process is directly exposed.
TRUST_PROXY=

# Only if the website is hosted on a DIFFERENT origin than this server. Comma-separated.
# ALLOWED_ORIGINS=https://www.example.com

# Serve ../frontend from this process (set false if the site is on a CDN/static host).
SERVE_STATIC=true

# Contact endpoint rate limit, per IP
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=15

# AI chatbot (POST /api/chat), powered by the NVIDIA API (build.nvidia.com). Leave the key empty to disable the chatbot.
# Generate a key at https://build.nvidia.com/settings/api-keys (starts with nvapi-). Keep it server-side only.
NVIDIA_API_KEY=
# Any hosted model that supports tool/function calling (the bot uses a send_enquiry tool).
CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# CHAT_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}   # extra JSON sent to the model; use {} for models that reject it
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
# CHAT_RATE_MAX=20        # messages per IP per 10 min
# CHAT_DAILY_CAP=400      # total model calls per day (usage guard)
